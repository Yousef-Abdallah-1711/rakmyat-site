# PostgreSQL 15+ (managed service recommended for production)
DATABASE_URL=postgres://user:password@localhost:5432/rakmyat

# Random 32+ character secret used to hash rate-limit identifiers. Generate uniquely per environment.
RATE_LIMIT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Set to a request header that your hosting proxy overwrites with a single validated client IP.
# Never use a client-controlled forwarding header. Local development uses a fixed loopback identity.
TRUSTED_CLIENT_IP_HEADER=

# Comma-separated exact public origins permitted to POST inquiries. Required in production.
CONTACT_ALLOWED_ORIGINS=

# Persistent PostgreSQL-backed inquiry request limits (per trusted client IP).
INQUIRY_RATE_LIMIT_15M_MAX=3
INQUIRY_RATE_LIMIT_24H_MAX=10

# SMTP delivery. Keep credentials in the hosting provider secret store.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
INQUIRY_NOTIFICATION_TO=yoseabdallah866@gmail.com

# Optional domain used by existing metadata/sitemap configuration.
NEXT_PUBLIC_SITE_URL=
