# Copy to deployment/production.env after owner approval; never commit that file.
# This placeholder is not a production domain and must be replaced before use.
PRODUCTION_HOSTNAME=approved-hostname-required.invalid
NEXT_PUBLIC_SITE_URL=https://approved-hostname-required.invalid
ROBOTS_INDEXING_ENABLED=false
INDEXING_APPROVED=false
POSTGRES_DB=rakmyat_prod
POSTGRES_USER=rakmyat_bootstrap
DATABASE_SSL=false
# Keep the configured limits aligned with the approved abuse-response policy.
INQUIRY_RATE_LIMIT_15M_MAX=3
INQUIRY_RATE_LIMIT_24H_MAX=10
# Caddy overwrites this header. If a CDN is added, configure trusted proxies there first.
TRUSTED_CLIENT_IP_HEADER=x-real-ip
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@rakmyat.online
SMTP_FROM=info@rakmyat.online
INQUIRY_NOTIFICATION_TO=yoseabdallah866@gmail.com
ACTIVE_SLOT=blue
RAKMYAT_IMAGE_BLUE=ghcr.io/yousef-abdallah-1711/rakmyat-site:replace-with-40-character-commit-sha
RAKMYAT_IMAGE_GREEN=ghcr.io/yousef-abdallah-1711/rakmyat-site:replace-with-40-character-commit-sha
RAKMYAT_IMAGE_MIGRATION=ghcr.io/yousef-abdallah-1711/rakmyat-site:replace-with-40-character-commit-sha
RAKMYAT_IMAGE_WORKER=ghcr.io/yousef-abdallah-1711/rakmyat-site:replace-with-40-character-commit-sha
RAKMYAT_IMAGE_ADMIN=ghcr.io/yousef-abdallah-1711/rakmyat-site:replace-with-40-character-commit-sha

# Operational scripts only. Set in the operator environment, not in the app env file.
# BACKUP_GPG_RECIPIENT=<approved-backup-operator-key-fingerprint>
# BACKUP_DESTINATION=<protected-off-host-mounted-directory>
# HEALTHCHECK_URL=https://<approved-hostname>
